@{
    ViewData["Title"] = "Không Có Quyền Truy Cập - Hoàng Gia E-Coffee";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5.3.3 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-page-body d-flex align-items-center justify-content-center min-vh-100 p-3">
    <div class="login-card-container text-center p-5" style="max-width: 540px; display: block;">
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h2 class="text-white fw-bold mb-2">Quyền Truy Cập Bị Hạn Chế</h2>
        <p class="text-secondary mb-4" style="color: #9ca3af !important;">
            Tài khoản của bạn hiện tại không có quyền hạn truy cập vào phân hệ này. Vui lòng đăng nhập bằng tài khoản Quản trị viên (Admin) hoặc liên hệ cấp quản lý.
        </p>
        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <a href="/Account/Login" class="btn btn-danger rounded-pill px-4 py-2 fw-bold">
                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập tài khoản khác
            </a>
            <a href="/" class="btn btn-outline-light rounded-pill px-4 py-2 fw-bold">
                <i class="bi bi-house-door me-1"></i>Về trang chủ
            </a>
        </div>
    </div>
</body>
</html>
