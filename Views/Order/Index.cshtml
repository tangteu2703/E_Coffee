@model E_Coffee.Models.OrderViewModel
@{
    ViewData["Title"] = "Hoàng Gia Coffee -Đặt Hàng";
}

<!-- Order Mode Info Bar -->
<div class="bg-body-tertiary border-bottom py-1.5">
    <div class="container-xl d-flex align-items-center justify-content-between flex-nowrap gap-2">
        <div class="d-flex align-items-center gap-2 min-w-0 overflow-hidden">
            <span class="badge bg-danger-subtle text-danger rounded-circle p-1 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px;">
                <i class="bi bi-geo-alt-fill small"></i>
            </span>
            <span class="small fw-bold text-secondary text-truncate">
                <span class="d-none d-sm-inline">Vị trí: </span><span class="text-danger" id="orderPageModeText">@Model.OrderMode.DisplayIdentifier</span>
            </span>
        </div>

        <button class="btn btn-sm btn-outline-secondary rounded-pill fw-semibold shadow-sm text-nowrap flex-shrink-0" onclick="ECoffee.openOrderModeModal()">
            <i class="bi bi-pencil-square me-1"></i><span class="d-none d-sm-inline">Đổi bàn / Địa chỉ</span><span class="d-sm-none">Đổi</span>
        </button>
    </div>
</div>

<!-- Category Filter Sticky Bar -->
<div class="sticky-top bg-white border-bottom py-2 shadow-xs" style="z-index: 990; top: 60px;">
    <div class="container-xl d-flex flex-column flex-md-row align-items-stretch align-items-md-center justify-content-between gap-2">
        <!-- Category Tabs (Flex Wrap so all categories are visible without scroll) -->
        <div class="d-flex flex-wrap align-items-center gap-2 py-1">
            <button class="btn btn-sm rounded-pill fw-bold @(Model.ActiveCategoryId == 0 ? "btn-dark shadow-sm" : "btn-light text-secondary border-0")" onclick="window.location.href='/Order'">
                <i class="bi bi-grid-fill me-1"></i> Tất Cả (@Model.Products.Count)
            </button>
            @foreach (var cat in Model.Categories)
            {
                <button class="btn btn-sm rounded-pill fw-bold @(Model.ActiveCategoryId == cat.Id ? "btn-dark shadow-sm" : "btn-light text-secondary border-0")" onclick="window.location.href='/Order?cat=@cat.Id'">
                    <i class="bi @cat.Icon me-1"></i> @cat.Name
                </button>
            }
        </div>

        <!-- Search Input -->
        <form method="get" action="/Order" class="position-relative flex-shrink-0" style="min-width: 220px;">
            <input type="hidden" name="cat" value="@Model.ActiveCategoryId" />
            <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted small"></i>
            <input type="text" name="q" class="form-control form-control-sm rounded-pill ps-5 bg-light border-light-subtle" placeholder="Tìm món ngon..." value="@Model.SearchQuery" />
        </form>
    </div>
</div>

<!-- Main Catalog Container with Bootstrap 2-Column Mobile Grid -->
<div class="container-xl my-3 my-md-4 mb-5">
    @if (Model.Products.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-emoji-frown display-4 text-muted"></i>
            <h4 class="fw-extrabold text-secondary mt-3">Không tìm thấy sản phẩm phù hợp</h4>
            <p class="text-muted small">Vui lòng thử tìm kiếm lại với từ khóa khác nhé!</p>
            <a href="/Order" class="btn btn-sm btn-danger rounded-pill px-4 py-2 fw-bold mt-2 shadow-sm">
                Xem Toàn Bộ Thực Đơn
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2 g-md-3">
            @foreach (var p in Model.Products)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card transition-all">
                        <div class="position-relative bg-light" style="height: 150px;">
                            @if (!string.IsNullOrEmpty(p.Badge))
                            {
                                <span class="badge bg-danger rounded-pill position-absolute top-0 start-0 m-2 shadow-sm" style="font-size: 0.7rem;">
                                    @p.Badge
                                </span>
                            }
                            <img src="@p.ImageUrl" class="w-100 h-100 object-fit-cover product-img" alt="@p.Name">
                        </div>
                        <div class="card-body p-2.5 p-md-3 d-flex flex-column">
                            <span class="text-uppercase fw-bold text-warning-emphasis" style="font-size: 0.65rem; letter-spacing: 0.5px;">@p.CategoryName</span>
                            <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@p.Name" style="font-size: 0.95rem;">@p.Name</h6>
                            <p class="card-text text-muted small mb-3 text-truncate-2 d-none d-sm-block" style="font-size: 0.8rem; line-height: 1.3;">@p.Description</p>

                            <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top border-dashed min-w-0">
                                <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-baseline gap-0 gap-sm-1.5 min-w-0 me-1">
                                    @if (p.HasPromo)
                                    {
                                        <span class="text-muted text-decoration-line-through lh-1 order-1 order-sm-2 mb-1 mb-sm-0" style="font-size: 0.72rem;">@p.BasePrice.ToString("N0")đ</span>
                                        <span class="fw-extrabold text-danger fs-6 lh-1 order-2 order-sm-1">@p.EffectivePrice.ToString("N0")đ</span>
                                    }
                                    else
                                    {
                                        <span class="fw-extrabold text-danger fs-6 lh-1">@p.BasePrice.ToString("N0")đ</span>
                                    }
                                </div>
                                <button class="btn btn-sm btn-danger rounded-pill px-2.5 px-md-3 py-1 fw-bold text-nowrap flex-shrink-0 shadow-sm" onclick="ECoffee.openCustomizationModal(@p.Id)">
                                    <i class="bi bi-plus-lg"></i> Chọn
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
