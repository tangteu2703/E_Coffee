<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hòang Gia E-Coffee POS & Quản Lý</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <!-- Bootstrap Icons 1.11.3 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <!-- Site Custom CSS & Bar CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bar.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="pos-layout-body bg-light">

    <!-- Dedicated Management Top Bar (No Footer Layout) -->
    <header class="app-header shadow-xs">
        <div class="container-fluid px-4 py-2 d-flex align-items-center justify-content-between">
            <!-- Brand & App Title -->
            <div class="d-flex align-items-center gap-3">
                <a href="/Bar" class="brand-logo text-decoration-none">
                    <div class="bg-danger text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px; font-size: 1.2rem; transform: rotate(-3deg);">
                        <i class="bi bi-cup-hot-fill"></i>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fw-extrabold text-danger lh-1" style="font-size: 1.2rem; letter-spacing: -0.5px;">HOÀNG GIA</span>
                        <span class="fw-bold text-warning-emphasis text-uppercase" style="font-size: 0.58rem; letter-spacing: 1.5px;">POS & QUẢN LÝ</span>
                    </div>
                </a>

                <div class="vr mx-2 d-none d-md-block" style="height: 24px; opacity: 0.2;"></div>

                <!-- Nav Menu for POS & Future Modules (Thống Kê, Báo Cáo Doanh Thu) -->
                <ul class="nav nav-pills d-none d-md-flex align-items-center gap-1">
                    <li class="nav-item">
                        <a href="/Bar" class="nav-link btn-sm fw-bold px-3 py-1.5 active bg-danger text-white rounded-pill">
                            <i class="bi bi-display me-1.5"></i>Quầy Bar & Pha Chế
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#" class="nav-link btn-sm fw-bold px-3 py-1.5 text-secondary rounded-pill" onclick="Swal.fire('Thông báo', 'Tính năng Báo cáo & Thống kê doanh thu đang được phát triển', 'info')">
                            <i class="bi bi-graph-up-arrow me-1.5"></i>Thống Kê Doanh Thu
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/" class="nav-link btn-sm fw-bold px-3 py-1.5 text-secondary rounded-pill">
                            <i class="bi bi-shop me-1.5"></i>Xem Trang Khách Hàng
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Right Profile & Live Clock -->
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-sm-flex align-items-center gap-2 bg-white border px-3 py-1.5 rounded-pill shadow-xs">
                    <i class="bi bi-clock-history text-danger"></i>
                    <span class="font-monospace fw-bold small text-dark" id="posClock">17:16:00</span>
                </div>

                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1.5 fw-bold d-flex align-items-center gap-2 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 24px; height: 24px; font-size: 0.75rem;">
                            P
                        </div>
                        <span class="d-none d-sm-inline">Pha Chế Ca 1</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 text-start mt-1">
                        <li><h6 class="dropdown-header">Cửa hàng: Vincom Center</h6></li>
                        <li><a class="dropdown-item small" href="#"><i class="bi bi-person-gear me-2"></i>Cấu hình quầy</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item small text-danger" href="/" onclick="Swal.fire('Đã đăng xuất', 'Hẹn gặp lại ca làm việc tiếp theo!', 'success')"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất ca</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content without Footer -->
    <main role="main" class="flex-fill">
        @RenderBody()
    </main>

    <!-- Bootstrap 5.3.3 JS & SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
