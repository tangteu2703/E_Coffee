@using E_Coffee.Models

<header class="sticky-top bg-white bg-opacity-95 backdrop-blur border-bottom shadow-xs">
    <div class="container-xl d-flex align-items-center justify-content-between py-2 px-3">
        <!-- Brand Logo -->
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
            <div class="bg-danger text-white rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; font-size: 1.2rem; transform: rotate(-3deg);">
                <i class="bi bi-cup-hot-fill"></i>
            </div>
            <div class="d-flex flex-column">
                <span class="fw-extrabold text-danger lh-1" style="font-size: 1.25rem; letter-spacing: -0.5px;">HOÀNG GIA</span>
                <span class="fw-bold text-warning-emphasis text-uppercase" style="font-size: 0.6rem; letter-spacing: 1.5px; margin-top: 1px;">E-COFFEE</span>
            </div>
        </a>

        <!-- Navigation Links (Desktop) -->
        <ul class="nav nav-pills d-flex align-items-center gap-1 mx-auto">
            <li class="nav-item">
                <a href="/" class="nav-link btn-sm fw-bold px-3 py-1.5 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active bg-secondary" : "text-dark")">
                    Trang Chủ
                </a>
            </li>
            <li class="nav-item">
                <a href="/Order" class="nav-link btn-sm fw-bold px-3 py-1.5 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active bg-danger" : "text-dark")">
                    Thực Đơn
                </a>
            </li>
        </ul>

        <!-- Right Header Actions -->
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-danger rounded-pill px-3 py-1.5 fw-bold d-flex align-items-center gap-2 shadow-sm" onclick="ECoffee.toggleCartDrawer(true)">
                <i class="bi bi-bag-heart-fill fs-6"></i>
                <span class="d-none d-sm-inline">Giỏ hàng</span>
                <span class="badge bg-warning text-dark rounded-circle px-2 py-1 font-monospace" id="cartBadgeCount" style="font-size: 0.75rem;">0</span>
            </button>
        </div>
    </div>
</header>
