@using E_Coffee.Models

<style>
    .brand-name {
        font-size: 0.8rem;
        letter-spacing: -0.5px;
    }
    @@media (min-width: 768px) {
        .brand-name {
            font-size: 1.25rem;
        }
    }
</style>

<header class="sticky-top bg-white bg-opacity-95 backdrop-blur border-bottom shadow-xs">
    <div class="container-xl d-flex align-items-center justify-content-between py-2 px-3">
        <!-- Brand Logo -->
        <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
            <img src="~/image/logo_hoanggia.png" alt="Hoàng Gia E-Coffee" class="rounded-3 shadow-sm object-fit-contain" style="width: 38px; height: 38px;" />
            <div class="d-flex flex-column" style="white-space: nowrap;">
                <span class="fw-extrabold text-danger lh-1 brand-name">HOÀNG GIA</span>
                <span class="fw-bold text-warning-emphasis text-uppercase" style="font-size: 0.6rem; letter-spacing: 1.5px; margin-top: 1px;">E-COFFEE</span>
            </div>
        </a>

        <!-- Navigation Links (Desktop) -->
        <ul class="nav nav-pills d-flex flex-nowrap align-items-center gap-1 mx-auto">
            <li class="nav-item">
                <a href="/" class="nav-link btn-sm fw-bold px-2 px-md-3 py-1 py-md-1.5 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active bg-secondary" : "text-dark")" style="white-space: nowrap;">
                    Trang Chủ
                </a>
            </li>
            <li class="nav-item">
                <a href="/Order" class="nav-link btn-sm fw-bold px-2 px-md-3 py-1 py-md-1.5 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active bg-danger" : "text-dark")" style="white-space: nowrap;">
                    Thực Đơn
                </a>
            </li>
        </ul>

        <!-- Right Header Actions -->
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name ?? "Quản Trị";
                var roleName = User.FindFirst("RoleDisplayName")?.Value ?? "Quản Trị";
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 px-md-3 py-1.5 fw-bold d-flex align-items-center gap-1.5 shadow-xs dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle text-danger"></i>
                        <span class="d-none d-md-inline">@fullName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 text-start mt-1">
                        <li><h6 class="dropdown-header">@roleName</h6></li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li><a class="dropdown-item small" href="/Analytics"><i class="bi bi-graph-up-arrow me-2 text-danger"></i>Thống kê doanh thu</a></li>
                            <li><a class="dropdown-item small" href="/ProductManagement"><i class="bi bi-shop me-2 text-warning-emphasis"></i>Quản lý sản phẩm</a></li>
                        }
                        <li><a class="dropdown-item small" href="/Bar"><i class="bi bi-display me-2 text-primary"></i>Quầy Bar pha chế</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item small text-danger fw-bold" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 px-md-3 py-1.5 fw-bold d-flex align-items-center gap-1.5 shadow-xs" title="Đăng nhập quản trị">
                    <i class="bi bi-person-lock"></i>
                    <span class="d-none d-md-inline">Login</span>
                </a>
            }

            <button class="btn btn-sm btn-danger rounded-pill px-3 py-1.5 fw-bold d-flex align-items-center gap-2 shadow-sm" onclick="ECoffee.toggleCartDrawer(true)">
                <i class="bi bi-bag-heart-fill fs-6"></i>
                <span class="d-none d-sm-inline">Giỏ hàng</span>
                <span class="badge bg-warning text-dark rounded-circle px-2 py-1 font-monospace" id="cartBadgeCount" style="font-size: 0.75rem;">0</span>
            </button>
        </div>
    </div>
</header>
